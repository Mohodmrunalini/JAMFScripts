####################################################################################################
# Detecting older apps 2023 and older
####################################################################################################
detect_old_versions_2023_or_lower() {
    found_old=false

    # Major Adobe apps we care about (same intent as your current whitelist)
    MAJOR_APPS=(
      "Adobe Premiere Pro"
      "Adobe Photoshop"
      "Adobe After Effects"
      "Adobe Media Encoder"
      "Adobe Illustrator"
      "Adobe InDesign"
      "Adobe InCopy"
      "Adobe Audition"
      "Adobe Bridge"
      "Adobe Lightroom"
      "Adobe XD"
      "Adobe Animate"
      "Adobe Character Animator"
      "Adobe Acrobat"
    )

    is_major_app() {
        local appname="$1"
        for p in "${MAJOR_APPS[@]}"; do
            if [[ "$appname" == "$p.app" || "$appname" == "$p "*".app" ]]; then
                return 0
            fi
        done
        return 1
    }

    # Extract a 4-digit year from things like:
    # "Adobe Premiere Pro 2024.app" or folder "Adobe Premiere Pro 2024"
    extract_year_from_string() {
        local s="$1"
        s="${s%.app}"
        if [[ "$s" =~ ([12][0-9]{3}) ]]; then
            echo "${match[1]}"
            return 0
        fi
        return 1
    }

    # Fallback thresholds for plist major versions when NO year exists in name.
    # These are "minimum major version that counts as 2024+"
    min_major_for_2024() {
        local base="$1"
        case "$base" in
          "Adobe Premiere Pro"|"Adobe Media Encoder"|"Adobe Audition"|"Adobe After Effects")
            echo 24 ;;   # 24.x = 2024 line for these
          "Adobe Photoshop")
            echo 25 ;;   # 25.x = 2024 line
          "Adobe Illustrator")
            echo 28 ;;   # 28.x = 2024 line
          "Adobe InDesign")
            echo 19 ;;   # 19.x = 2024 line
          "Adobe Acrobat")
            echo 24 ;;   # adjust if your Acrobat naming/versioning differs
          *)
            echo 999 ;;  # unknown => don't flag on fallback
        esac
    }

    apps=()

    # 1) Top-level Adobe apps in /Applications
    while IFS= read -r app; do
        apps+=("$app")
    done < <(find /Applications -maxdepth 1 -type d -name "Adobe*.app" 2>/dev/null)

    # 2) One-level subfolder Adobe apps, e.g. /Applications/Adobe Premiere Pro 2024/Adobe Premiere Pro 2024.app
    while IFS= read -r app; do
        apps+=("$app")
    done < <(find /Applications -maxdepth 2 -mindepth 2 -type d -path "/Applications/Adobe*/*.app" 2>/dev/null)

    for app in "${apps[@]}"; do
        appname="$(basename "$app")"

        if ! is_major_app "$appname"; then
            continue
        fi

        # Normalize base name (strip ".app" and trailing year like " 2024")
        base="${appname%.app}"
        base="${base%% [12][0-9][0-9][0-9]}"

        # ---- 1) YEAR-FIRST: check year from app name OR parent folder name ----
        year=""
        year="$(extract_year_from_string "$(basename "$app")" 2>/dev/null)"
        if [[ -z "$year" ]]; then
            year="$(extract_year_from_string "$(basename "$(dirname "$app")")" 2>/dev/null)"
        fi

        if [[ -n "$year" ]]; then
            if [[ "$year" -le 2023 ]]; then
                logMe "Old Adobe version detected: $appname (Year $year)"
                found_old=true
            fi
            continue
        fi

        # ---- 2) FALLBACK: no year in name -> inspect Info.plist version with per-app thresholds ----
        info_plist="$app/Contents/Info.plist"
        if [[ -f "$info_plist" ]]; then
            version=$(/usr/bin/defaults read "$info_plist" CFBundleShortVersionString 2>/dev/null)
            major_version=$(echo "$version" | cut -d "." -f 1)

            min_major="$(min_major_for_2024 "$base")"
            if [[ "$min_major" -ne 999 ]] && [[ "$major_version" =~ ^[0-9]+$ ]] && [[ "$major_version" -lt "$min_major" ]]; then
                logMe "Old Adobe version detected: $appname (Version $version)"
                found_old=true
            fi
        fi
    done
}

####################################################################################################
#
# Main Script
#
####################################################################################################

autoload 'is-at-least'

# Create logs early so we can log and exit cleanly before any prompt
create_log_directory

# 1) Detect duplicates (multi-version installs)
declare -a adobeDuplicates
adobeDuplicates=$(detect_adobe_apps)

# 2) Detect any 2023-or-older installs
detect_old_versions_2023_or_lower

# 3) New behavior gate:
#    - If duplicates exist BUT no 2023-or-older => NO PROMPT, exit 0
#    - If no 2023-or-older and no duplicates => exit 0 (keeps prior "No Old Versions" behavior)
if [[ "$found_old" == false ]]; then
    if [[ -n "$adobeDuplicates" ]]; then
        logMe "Duplicates found but all versions are 2024+. Exiting silently with code 0."
        cleanup_and_exit 0
    else
        logMe "No old versions found and no duplicates. Exiting with code 0."
        echo "<result>No Old Versions</result>"
        cleanup_and_exit 0
    fi
fi

# 4) If we got here, at least one 2023-or-older exists => proceed with prompt flow
logMe "Old Versions Found, Prompting user for uninstallation"

check_swift_dialog_install || cleanup_and_exit 1
#check_support_files
create_infobox_message
welcomemsg
cleanup_and_exit 0
